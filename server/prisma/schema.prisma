generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum IntegrationEntity {
  CUSTOMER
  PRODUCT
  INVENTORY
  ORDER
}

enum IntegrationSyncStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String   @id @default(cuid())
  customerNumber String   @unique
  firstName      String
  lastName       String
  email          String   @unique
  phone          String
  address        String
  city           String
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lastName, firstName])
}

model Product {
  id            String      @id @default(cuid())
  sku           String      @unique
  name          String
  description   String?
  category      String
  price         Decimal     @db.Decimal(10, 2)
  stockQuantity Int         @default(0)
  minimumStock  Int         @default(0)
  orderItems    OrderItem[]
  movements     InventoryMovement[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([category])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      OrderStatus @default(DRAFT)
  subtotal    Decimal     @db.Decimal(10, 2)
  vatAmount   Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id                String                @id @default(cuid())
  productId         String
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type              InventoryMovementType
  quantity          Int
  previousQuantity  Int
  newQuantity       Int
  reason            String?
  createdAt         DateTime              @default(now())

  @@index([productId])
  @@index([createdAt])
}

model ApiLog {
  id           String   @id @default(cuid())
  method       String
  endpoint     String
  statusCode   Int
  responseTime Int
  userEmail    String?
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([timestamp])
}

// Records one simulated Priority sync run per entity. "Sync All" creates one
// row per entity (never an "ALL" row), so this table stays a flat, filterable
// history. Purely a record of a simulated outbound sync — never touches
// Customer/Product/Order/InventoryMovement data.
model IntegrationSync {
  id               String                @id @default(cuid())
  entity           IntegrationEntity
  status           IntegrationSyncStatus
  startedAt        DateTime
  completedAt      DateTime
  durationMs       Int
  recordsProcessed Int
  recordsSucceeded Int
  recordsFailed    Int
  errorMessage     String?
  payloadSummary   String?
  createdAt        DateTime              @default(now())

  @@index([createdAt])
  @@index([entity])
}
